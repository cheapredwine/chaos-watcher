{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "chaos-watcher",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "ai": { "binding": "AI" },
  "browser": { "binding": "BROWSER" },
  "durable_objects": {
    "bindings": [{ "name": "WATCHER", "class_name": "WatcherAgent" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["WatcherAgent"] }],
  "observability": { "enabled": true },
  "vars": {
    // Set to the deployed URL after first deploy (used by the script watcher
    // and the agent's browse tool to reach ChaosCo).
    "SITE_ORIGIN": "http://localhost:8787",
    // Flip to "true" after configuring a Cloudflare Access application
    // covering /journal and /api/* (see docs/runbook.md).
    "REQUIRE_ACCESS": "false"
  }
}
